# Copy to `.env` at the repository root. Consumed by docker-compose.yml only —
# the applications read their own env files (`backend/.env`, `frontend/.env`).
#
# Defaults are development credentials committed on purpose. Never reuse them
# anywhere reachable from outside this machine.

POSTGRES_USER=testvasja
POSTGRES_PASSWORD=testvasja
POSTGRES_DB=testvasja

# Host-side port. Change it if something else already owns 5432, and keep
# DATABASE_URL in backend/.env in sync.
POSTGRES_PORT=5432
