            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionPublic": {
        "properties": {
          "active_organization_id": {
            "anyOf": [
              {
                "format": "uuid",
