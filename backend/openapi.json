        "title": "SessionPublic",
        "type": "object"
      },
      "SetActiveOrganizationRequest": {
        "properties": {
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          }
        },
        "required": [
          "organization_id"
        ],
        "title": "SetActiveOrganizationRequest",
        "type": "object"
      },
      "UserPublic": {
        "description": "Everything about a user the API is willing to disclose.\n\nThe stored credential is absent by construction rather than by filtering:\nthere is no code path that could include it. `test_identity.py` asserts the\nfield name appears nowhere in the OpenAPI document — including in prose like\nthis one — so the guard cannot be defeated by a description.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserPublic",
        "type": "object"
      }
    }
